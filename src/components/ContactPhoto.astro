---
/**
 * The portrait used beside the invitation to get in touch (footer and the
 * contact page). The photograph is tall; the frame shows the head and hand.
 */
import { Picture } from 'astro:assets';
import sun from '@/assets/portraits/sun.jpg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<figure class:list={['cphoto', className]}>
  <div class="cphoto__frame">
    <Picture
      src={sun}
      alt="Soroush Jaberi in sunglasses, chin resting on his hand, lit by low sun through a window"
      formats={['avif', 'webp']}
      widths={[320, 480, 640]}
      sizes="(min-width: 52rem) 19rem, 60vw"
      loading="lazy"
      quality={70}
    />
  </div>
</figure>

<style>
  .cphoto {
    position: relative;
    width: 100%;
  }
  .cphoto::before {
    content: '';
    position: absolute;
    inset: 0.8rem -0.8rem -0.8rem 0.8rem;
    border: 1px solid var(--warm-fill);
    border-radius: var(--radius-lg);
    opacity: 0.6;
  }
  .cphoto__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #14110d;
    box-shadow: var(--shadow);
  }
  .cphoto__frame :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cphoto__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
  }
</style>
