---
/**
 * Five photographs as a fanned deck of prints.
 *
 * Every size comes from the width of the deck itself (container query units),
 * so the fan fits a 320px phone and a wide desktop with the same rules: the
 * prints get smaller and overlap more, but never run off the screen.
 * The fan opens as the section scrolls into view (--progress from
 * scrollfx.ts). A print comes forward when hovered, tapped or focused.
 */
import { Picture } from 'astro:assets';
import cafe from '@/assets/portraits/cafe.jpg';
import formal from '@/assets/portraits/formal.jpg';
import library from '@/assets/portraits/library.jpg';
import outdoor from '@/assets/portraits/outdoor.jpg';
import sun from '@/assets/portraits/sun.jpg';

// Left to right once fanned; the middle print starts on top.
const frames = [
  { src: outdoor, alt: 'Soroush Jaberi standing outdoors on a sunny street, in a light sweater and tie', pos: '50% 26%', slot: -2 },
  { src: cafe, alt: 'Soroush Jaberi smiling, seated at a wooden table', pos: '55% 20%', slot: -1 },
  { src: formal, alt: 'Soroush Jaberi seated at a table by a window, hands folded', pos: '50% 28%', slot: 0 },
  { src: library, alt: 'Soroush Jaberi in a cap and hoodie in front of bookshelves', pos: '50% 20%', slot: 1 },
  { src: sun, alt: 'Soroush Jaberi in sunglasses, lit by low sun through a window', pos: '45% 28%', slot: 2 },
];
---

<div class="deck-wrap">
  <ul class="deck" role="list" data-progress>
    {
      frames.map((f) => (
        <li style={`--slot: ${f.slot}; --z: ${3 - Math.abs(f.slot)}`}>
          <button type="button" class="print">
            <Picture
              src={f.src}
              alt={f.alt}
              formats={['avif', 'webp']}
              widths={[240, 400, 560]}
              sizes="(min-width: 62rem) 16rem, 30vw"
              width={560}
              height={700}
              fit="cover"
              position="top"
              quality={68}
              style={`object-position: ${f.pos}`}
            />
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .deck-wrap {
    container-type: inline-size;
  }
  .deck {
    --progress: 1;
    /* Print width, and the distance between neighbouring prints. Both scale
       with the deck, and the step is chosen so the outer prints stay inside. */
    --w: clamp(6.25rem, 22vw, 16rem);
    --step: min(11rem, (86vw - var(--w)) / 4.5);
    --open: clamp(0.64, var(--progress) * 2.2, 1);
    position: relative;
    height: calc(var(--w) * 1.62 + 2rem);
  }
  @supports (width: 1cqw) {
    .deck {
      --w: clamp(6.25rem, 25cqw, 16rem);
      --step: min(11rem, (100cqw - var(--w)) / 4.5);
    }
  }
  .deck li {
    position: absolute;
    left: 50%;
    top: 1rem;
    z-index: var(--z);
    width: var(--w);
    margin-left: calc(var(--w) / -2);
    transform: translateX(calc(var(--slot) * var(--open) * var(--step)))
      translateY(calc(var(--slot) * var(--slot) * var(--open) * var(--w) * 0.04))
      rotate(calc(var(--slot) * var(--open) * 5deg));
    transition: transform 0.5s var(--ease-out);
  }
  .print {
    display: block;
    width: 100%;
    padding: calc(var(--w) * 0.03) calc(var(--w) * 0.03) calc(var(--w) * 0.11);
    background: #f7f3ea;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.18),
      0 14px 30px -14px rgb(0 0 0 / 0.45);
    cursor: pointer;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.3s;
  }
  .print :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1px;
    background: #d9d4c6;
  }
  /* Bring a print forward: on hover, on tap (focus) and from the keyboard. */
  .deck li:hover,
  .deck li:focus-within {
    z-index: 10;
  }
  .deck li:hover .print,
  .deck li:focus-within .print {
    transform: translateY(calc(var(--w) * -0.07)) rotate(calc(var(--slot) * -5deg)) scale(1.07);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.2),
      0 30px 50px -22px rgb(0 0 0 / 0.6);
  }
  .print:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .deck {
      --open: 1;
    }
  }
</style>
