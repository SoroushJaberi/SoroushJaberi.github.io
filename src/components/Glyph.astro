---
/**
 * Small drawings that sit beside a work entry. Each one is a diagram of the
 * project's idea, not decoration: the conflict study's intervals, a fusion of
 * two signals, the U of a U-Net, the steps of a course, a retrieval hop.
 */
interface Props {
  kind: 'conflict' | 'fusion' | 'unet' | 'path' | 'retrieval' | 'none';
}
const { kind } = Astro.props;
---

{
  kind !== 'none' && (
    <svg class={`glyph glyph--${kind}`} viewBox="0 0 120 72" fill="none" aria-hidden="true" focusable="false">
      {kind === 'conflict' && (
        <>
          <path class="g-rule" d="M8 62h104" />
          <rect class="g-band" x="56" y="8" width="24" height="54" />
          {[
            [16, 50, 62, 56],
            [28, 46, 58, 51],
            [40, 58, 70, 64],
            [52, 54, 66, 60],
          ].map(([y, a, b, v], i) => (
            <g style={`--i: ${i}`}>
              <path class="g-line" d={`M${a} ${y}H${b}`} />
              <circle class="g-dot" cx={v} cy={y} r="3.4" />
            </g>
          ))}
        </>
      )}

      {kind === 'fusion' && (
        <>
          <path class="g-line g-flow" d="M8 18h34c14 0 16 18 30 18h18" />
          <path class="g-line g-flow g-flow--b" d="M8 54h34c14 0 16-18 30-18h18" />
          <circle class="g-ring" cx="8" cy="18" r="3.4" />
          <circle class="g-ring" cx="8" cy="54" r="3.4" />
          <circle class="g-dot" cx="96" cy="36" r="6" />
          <path class="g-rule" d="M102 36h12" />
        </>
      )}

      {kind === 'unet' && (
        <>
          {[
            [10, 8, 34],
            [26, 20, 26],
            [42, 32, 18],
            [58, 40, 12],
            [74, 32, 18],
            [90, 20, 26],
            [106, 8, 34],
          ].map(([x, y, h], i) => (
            <rect class={i === 3 ? 'g-dot g-bar' : 'g-bar'} style={`--i: ${i}`} x={x - 3} y={y} width="6" height={h} rx="1" />
          ))}
          <path class="g-skip" d="M16 14h84M32 26h52M48 38h20" />
        </>
      )}

      {kind === 'path' && (
        <>
          <path class="g-line" d="M8 60h14v-9h16v-9h16v-9h16v-9h16v-9h16" />
          {[
            [15, 60],
            [30, 51],
            [46, 42],
            [62, 33],
            [78, 24],
            [94, 15],
          ].map(([x, y], i) => (
            <circle class={i === 0 ? 'g-dot' : 'g-ring'} style={`--i: ${i}`} cx={x} cy={y} r="3.4" />
          ))}
        </>
      )}

      {kind === 'retrieval' && (
        <>
          {[14, 28, 42, 56].map((y, i) => (
            <path class={i === 1 ? 'g-line g-hit' : 'g-rule'} d={`M8 ${y}h36`} />
          ))}
          <path class="g-line g-flow" d="M48 28h20c8 0 8 8 16 8h8" />
          <circle class="g-dot" cx="100" cy="36" r="6" />
        </>
      )}
    </svg>
  )
}

<style>
  .glyph {
    width: 7.5rem;
    height: auto;
    color: var(--ink-3);
    overflow: visible;
  }
  .g-rule {
    stroke: var(--rule-strong);
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .g-line {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .g-band {
    fill: var(--warm-soft);
  }
  .g-dot {
    fill: var(--warm-fill);
  }
  .g-ring {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .g-bar {
    fill: currentColor;
    opacity: 0.55;
  }
  .g-bar.g-dot {
    fill: var(--warm-fill);
    opacity: 1;
  }
  .g-skip {
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.7;
  }
  .g-hit {
    stroke: var(--warm-fill);
    stroke-width: 2.4;
  }

  /* A little life when the row is hovered or focused. */
  .glyph circle,
  .glyph rect,
  .glyph path {
    transition:
      translate 0.5s var(--ease-spring),
      scale 0.5s var(--ease-spring),
      stroke-dashoffset 0.8s var(--ease),
      opacity 0.3s;
    transition-delay: calc(var(--i, 0) * 45ms);
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.entry:hover) .glyph--conflict .g-dot,
  :global(.entry:focus-within) .glyph--conflict .g-dot {
    translate: 5px 0;
  }
  :global(.entry:hover) .glyph--fusion .g-dot,
  :global(.entry:focus-within) .glyph--fusion .g-dot,
  :global(.entry:hover) .glyph--retrieval .g-dot,
  :global(.entry:focus-within) .glyph--retrieval .g-dot {
    scale: 1.3;
  }
  :global(.entry:hover) .glyph--unet .g-bar,
  :global(.entry:focus-within) .glyph--unet .g-bar {
    scale: 1 1.12;
    opacity: 0.85;
  }
  :global(.entry:hover) .glyph--path .g-ring,
  :global(.entry:focus-within) .glyph--path .g-ring {
    translate: 0 -3px;
  }
  .g-flow {
    stroke-dasharray: 4 4;
  }
  :global(.entry:hover) .g-flow,
  :global(.entry:focus-within) .g-flow {
    stroke-dashoffset: -16;
  }
</style>
