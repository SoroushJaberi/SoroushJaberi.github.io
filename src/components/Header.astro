---
/**
 * Header and menu, in the pattern of the previous site: the name at the left,
 * a boxed bar of links in the middle (wide screens), and a "Menu" button that
 * opens a compact, numbered list.
 *
 * The menu is a native <dialog>, so focus is trapped and Esc closes it.
 * Without JavaScript the links are shown inline instead.
 */
import { nav, site, profiles, mailto, type NavItem } from '@/data/site';
import { getPosts } from '@/lib/content';
import ThemeToggle from './ThemeToggle.astro';

// "Writing" joins the navigation by itself once a post is published.
const posts = await getPosts();
const bar: NavItem[] =
  posts.length > 0 ? [...nav.slice(0, 2), { label: 'Writing', href: '/writing/' }, ...nav.slice(2)] : nav;
const menu: NavItem[] = [{ label: 'Home', href: '/' }, ...bar];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const two = (n: number) => String(n).padStart(2, '0');
---

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label={`${site.name}, home`}>{site.name}</a>

  <nav class="bar" aria-label="Primary">
    {
      bar.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="tools">
    <ThemeToggle />
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>Menu</button>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Site menu" data-menu>
  <div class="menu__panel">
    <div class="menu__top">
      <span class="menu__title">Menu</span>
      <button class="menu__close" type="button" data-menu-close>Close</button>
    </div>

    <nav class="menu__nav" aria-label="All pages">
      {
        menu.map((item, i) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} style={`--i: ${i}`}>
            <span class="menu__label">{item.label}</span>
            <span class="menu__n" aria-hidden="true">
              {two(i + 1)}
            </span>
          </a>
        ))
      }
    </nav>

    <p class="menu__links">
      {
        profiles.map((p) => (
          <a href={p.href} rel="me noopener">
            {p.label}
          </a>
        ))
      }
      <a href={mailto()}>Email</a>
      <a href={site.cv}>CV</a>
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (dialog) {
    const modal = typeof dialog.showModal === 'function';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const close = () => {
      if (!dialog.hasAttribute('open')) return;
      dialog.classList.add('is-closing');
      window.setTimeout(
        () => {
          dialog.classList.remove('is-closing');
          if (modal) dialog.close();
          else dialog.removeAttribute('open');
        },
        reduce.matches ? 0 : 200,
      );
    };

    for (const button of document.querySelectorAll('[data-menu-open]')) {
      button.addEventListener('click', () => {
        if (modal) dialog.showModal();
        else dialog.setAttribute('open', '');
      });
    }
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close);
    // Esc: play the closing animation instead of vanishing.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      // A click on the dimmed area around the panel closes the menu.
      if (target === dialog) close();
      // So does a link to the page you are already on.
      const link = target.closest('a');
      if (link && link.pathname === location.pathname && !link.hash) close();
    });
  }

  // The bar gains a backdrop once the page has scrolled.
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header);
    padding-inline: var(--gutter);
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
  }
  .site-header.is-scrolled .bar,
  .site-header.is-scrolled .menu-btn {
    background: var(--paper);
  }
  .site-header.is-scrolled {
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--rule);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-top: 0.2rem;
    color: var(--ink);
    letter-spacing: 0.22em;
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(var(--rule-strong), var(--rule-strong)) no-repeat 0 calc(100% - 0.55rem) / 100% 1px;
    transition:
      color 0.2s,
      background-size 0.3s;
  }
  .brand:hover {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
  }

  /* The boxed bar of links. Wide screens only; the Menu button covers the rest. */
  .bar {
    display: none;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  @media (min-width: 62rem) {
    .bar {
      display: flex;
    }
  }
  .bar a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.85rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .bar a:hover,
  .bar a[aria-current='page'] {
    color: var(--accent);
  }
  .bar a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .menu-btn {
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .menu-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 22rem) {
    .site-header {
      letter-spacing: 0.1em;
    }
    .brand {
      letter-spacing: 0.12em;
    }
  }

  /* ---- the menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 3rem 1.5rem;
    border: 0;
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[open] {
    display: grid;
    place-items: center;
    animation: menu-fade 0.24s ease-out both;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu__panel {
    width: min(100%, 24rem);
    font-family: var(--sans);
    animation: menu-rise 0.32s var(--ease-out) both;
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
    padding-inline: 0.25rem;
  }
  .menu__title,
  .menu__close,
  .menu__n,
  .menu__links {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .menu__close {
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-2);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .menu__close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .menu__nav {
    display: grid;
    gap: 0.4rem;
  }
  .menu__nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.4rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 1rem;
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.25s,
      background-color 0.25s,
      color 0.25s;
    animation: rise 0.35s var(--ease-out) both;
    animation-delay: calc(var(--i) * 30ms + 40ms);
  }
  .menu__label {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .menu__nav a:hover,
  .menu__nav a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .menu__nav a:hover .menu__n {
    color: var(--accent);
  }
  .menu__nav a[aria-current='page'] {
    border-color: var(--accent);
  }
  .menu__nav a[aria-current='page'] .menu__n {
    color: var(--accent);
  }
  .menu__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.5rem;
    margin-top: 1.25rem;
  }
  .menu__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .menu__links a:hover {
    color: var(--accent);
  }
  .menu.is-closing {
    animation: menu-fade 0.2s ease-in reverse both;
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-rise {
    from {
      opacity: 0;
      translate: 0 0.9rem;
      scale: 0.98;
    }
  }
  :global(html:has(dialog.menu[open])) {
    overflow: hidden;
  }
</style>

<noscript>
  <style is:inline>
    .site-header .bar {
      display: flex !important;
    }
    .site-header .menu-btn {
      display: none;
    }
  </style>
</noscript>
