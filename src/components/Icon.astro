---
/**
 * The site's icon set: one drawing style (24px grid, 1.6px round strokes),
 * so every icon looks like it came from the same pen. Add an icon by adding
 * an entry to `icons`; use it with <Icon name="…" />.
 *
 * Brand glyphs (GitHub, LinkedIn, YouTube) follow the Feather set (MIT).
 */
const icons = {
  // Profiles
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  youtube:
    '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><path d="M9.75 15.02l5.75-3.27-5.75-3.27v6.54z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7.5l8.5 6 8.5-6"/>',
  cv: '<path d="M14 3H7.5A2.5 2.5 0 0 0 5 5.5v13A2.5 2.5 0 0 0 7.5 21h9a2.5 2.5 0 0 0 2.5-2.5V8l-5-5z"/><path d="M14 3v5h5M12 11v6M9.5 14.5L12 17l2.5-2.5"/>',
  // Audiences
  cap: '<path d="M2 9.5l10-5 10 5-10 5-10-5z"/><path d="M6 11.8V16c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.2M22 9.5V15"/>',
  briefcase:
    '<rect x="3" y="7.5" width="18" height="12.5" rx="2.5"/><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3 13h18M12 12v2"/>',
  cube: '<path d="M12 2.8l8.2 4.7v9L12 21.2l-8.2-4.7v-9L12 2.8z"/><path d="M3.8 7.5L12 12.2l8.2-4.7M12 12.2v9"/>',
  flask:
    '<path d="M9 3h6M10 3v6.3L4.7 18a2 2 0 0 0 1.7 3h11.2a2 2 0 0 0 1.7-3L14 9.3V3"/><path d="M7.6 15h8.8"/>',
  // Topics
  language: '<path d="M4 5h16v11H10l-5 4v-4H4V5z"/><path d="M8 9h8M8 12.5h5"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/>',
  eye: '<path d="M2 12s3.6-6.8 10-6.8S22 12 22 12s-3.6 6.8-10 6.8S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  pulse: '<path d="M2.5 12h4l2.2-5.5 4.3 11 2.3-5.5h6.2"/>',
  chip: '<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.6" y="9.6" width="4.8" height="4.8" rx="0.6"/><path d="M9 2.5V6M15 2.5V6M9 18v3.5M15 18v3.5M2.5 9H6M2.5 15H6M18 9h3.5M18 15h3.5"/>',
  chart: '<path d="M4 4v16h16"/><path d="M8.5 16v-4M12.5 16V8M16.5 16v-6"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v14.5H6.5A2.5 2.5 0 0 0 4 20V5.5z"/><path d="M4 20a2.5 2.5 0 0 0 2.5 2.5H20M8.5 7.5h7"/>',
  play: '<path d="M7 4.5l12.5 7.5L7 19.5v-15z"/>',
  pin: '<path d="M12 21.5s7-6.3 7-11.7a7 7 0 1 0-14 0c0 5.4 7 11.7 7 11.7z"/><circle cx="12" cy="9.8" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.3 2"/>',
  check: '<path d="M4.5 12.5l5 5 10-11"/>',
  spark: '<path d="M12 3v5M12 16v5M3 12h5M16 12h5M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name. Omit for decorative icons (the default). */
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>

<style is:global>
  .icon {
    flex: none;
    overflow: visible;
  }
  /* Icons redraw themselves when their link or card is hovered. */
  @media (prefers-reduced-motion: no-preference) {
    :is(a, button, .has-icon):hover > .icon :is(path, rect, circle),
    :is(a, button, .has-icon):hover > * > .icon :is(path, rect, circle) {
      animation: icon-draw 0.7s var(--ease-out) both;
    }
  }
  @keyframes icon-draw {
    from {
      stroke-dasharray: 90;
      stroke-dashoffset: 90;
    }
    to {
      stroke-dasharray: 90;
      stroke-dashoffset: 0;
    }
  }
</style>
