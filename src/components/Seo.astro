---
/**
 * Everything that goes in <head> for discovery and sharing: title, canonical,
 * Open Graph / Twitter cards, JSON-LD. One place, used by the base layout.
 */
import { site, links } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the generated share image, e.g. "/og/work/hvb-persian.png". */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
}

const {
  title,
  description = site.description,
  image = '/og/index.png',
  type = 'website',
  schema = [],
  noindex = false,
  published,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const person = {
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: site.name,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  jobTitle: 'AI researcher and data scientist',
  description: site.description,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Islamic Azad University' },
  knowsAbout: [
    'Machine learning',
    'Natural language processing',
    'Large language models',
    'Retrieval-augmented generation',
    'Information retrieval',
    'Computer vision',
    'Medical image segmentation',
  ],
  knowsLanguage: ['fa', 'en'],
  sameAs: Object.values(links),
};

const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: Astro.site?.href,
  name: site.name,
  description: site.description,
  inLanguage: 'en',
  publisher: { '@id': person['@id'] },
};

const graph = { '@context': 'https://schema.org', '@graph': [person, website, ...schema] };
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={site.name} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? `${site.name} — ${site.role}`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ? `${title} — ${site.name}` : `${site.name}, ${site.role}`} />
{published && <meta property="article:published_time" content={published.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? `${site.name} — ${site.role}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
