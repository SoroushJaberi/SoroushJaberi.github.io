---
/**
 * Selected work as a reel of panels that moves sideways.
 *
 * Two layouts, chosen by src/scripts/scrollfx.ts by measuring the screen:
 *
 *   pinned (.is-pinned)  the section holds still and scrolling the page
 *                        carries the panels sideways. Used when a panel fits
 *                        in one screen, on any device.
 *   row (default)        an ordinary sideways-scrolling row with snap points.
 *                        Used on short screens, with reduced motion, and
 *                        without JavaScript.
 *
 * In both, the panels can be moved by scrolling, by swiping, by dragging
 * with a mouse, with the two arrow buttons, and from the keyboard.
 */
import type { CollectionEntry } from 'astro:content';
import Glyph from './Glyph.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
  total: number;
}
const { entries, total } = Astro.props;
const kindLabel = { research: 'Research', engineering: 'Engineering', teaching: 'Teaching' } as const;
const two = (n: number) => String(n).padStart(2, '0');
---

<section class="reel" id="work" data-hscroll aria-labelledby="reel-title">
  <div class="reel__pin" data-hscroll-pin>
    <header class="wrap reel__head">
      <div>
        <p class="label label--tick">Selected work</p>
        <h2 id="reel-title" class="reel__title">Four projects. <span class="accent">What came out of each.</span></h2>
      </div>
      <div class="reel__controls">
        <p class="reel__meter" aria-hidden="true">
          <span class="num"><b data-hscroll-count>01</b> / {two(entries.length + 1)}</span>
          <span class="reel__bar"><i data-hscroll-bar></i></span>
        </p>
        <div class="reel__nav">
          <button type="button" class="reel__btn reel__btn--prev" data-hscroll-prev aria-label="Previous project" disabled>
            <span class="icon-arrow" aria-hidden="true"></span>
          </button>
          <button type="button" class="reel__btn" data-hscroll-next aria-label="Next project">
            <span class="icon-arrow" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>

    <ol class="reel__track" role="list" data-hscroll-track>
      {
        entries.map((entry, i) => (
          <li class="panel card" data-tilt="3">
            <div class="panel__text">
              <p class="panel__meta small">
                <span class="panel__n num">{two(i + 1)}</span>
                <span>{kindLabel[entry.data.kind]}</span>
                <span class="num">{entry.data.period}</span>
                {entry.data.status && <span>{entry.data.status}</span>}
              </p>
              <h3 class="panel__title">
                <a href={`/work/${entry.id}/`} style={`view-transition-name: work-${entry.id}`}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="panel__finding">{entry.data.finding ?? entry.data.summary}</p>
              <p class="panel__tags small">{entry.data.tags.join(' · ')}</p>
              <span class="arrow" aria-hidden="true">
                Case study
              </span>
            </div>
            <div class="panel__side">
              <div class="panel__glyph">
                <Glyph kind={entry.data.glyph} />
              </div>
              {entry.data.stats.length > 0 && (
                <dl class="panel__stats">
                  {entry.data.stats.map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd class="num">{s.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </li>
        ))
      }
      <li class="panel panel--end">
        <p class="label">And the rest</p>
        <p class="panel__endline">
          <a href="/work/">
            All {total} projects
            <span class="icon-arrow" aria-hidden="true"></span>
          </a>
        </p>
        <p class="small">Smaller builds, each with its repository.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .reel {
    position: relative;
    border-top: 1px solid var(--rule);
  }
  .reel__pin {
    padding-block: var(--section);
  }
  .reel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    margin-bottom: clamp(1.25rem, 3vh, 2.5rem);
  }
  .reel__title {
    margin-top: 0.9rem;
    font-size: var(--step-3);
    letter-spacing: -0.028em;
    line-height: 1.06;
    max-width: 18ch;
  }

  /* Counter, progress line and the two arrows. They need the script. */
  .reel__controls {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }
  :global(.js) .reel__controls {
    display: flex;
  }
  .reel__meter {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    white-space: nowrap;
  }
  .reel__meter b {
    color: var(--ink);
  }
  .reel__bar {
    display: block;
    width: clamp(3.5rem, 12vw, 9rem);
    height: 2px;
    background: var(--rule);
    overflow: hidden;
  }
  .reel__bar i {
    display: block;
    height: 100%;
    background: var(--accent-fill);
    transform-origin: left;
    transform: scaleX(0);
  }
  .reel__nav {
    display: flex;
    gap: 0.4rem;
  }
  .reel__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      opacity 0.2s;
  }
  .reel__btn .icon-arrow {
    width: 1rem;
    height: 1rem;
  }
  .reel__btn--prev .icon-arrow {
    transform: rotate(180deg);
  }
  .reel__btn:hover:not(:disabled) {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }
  .reel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ---------- row (default): a sideways-scrolling list ---------- */
  .reel__track {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    padding-inline: var(--gutter);
    padding-inline: max(var(--gutter), (100vw - var(--max)) / 2);
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .reel__track::-webkit-scrollbar {
    display: none;
  }
  /* While a mouse drags the row, snapping must not fight the pointer. */
  .reel.is-dragging .reel__track {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }

  .panel {
    position: relative;
    flex: none;
    width: min(86vw, 62rem);
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 1.25rem 3rem;
    padding: clamp(1.25rem, 3.5vw, 3rem);
    overflow: hidden;
  }
  /* The lean towards the pointer, and the light that follows it: mouse only. */
  @media (hover: hover) {
    .panel.card {
      transform: perspective(70rem) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition:
        transform 0.5s var(--ease-out),
        border-color 0.3s;
    }
    .panel.card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(28rem 20rem at var(--gx, 80%) var(--gy, 0%), var(--glow-a), transparent 70%);
      opacity: 0.7;
      pointer-events: none;
    }
    .panel.card:hover {
      border-color: var(--rule-strong);
    }
  }
  @media (min-width: 52rem) {
    .panel {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-content: stretch;
      align-items: stretch;
      min-height: min(30rem, 60vh);
    }
  }
  .panel__text {
    display: flex;
    flex-direction: column;
    align-items: start;
    min-width: 0;
  }
  .panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0;
    color: var(--ink-3);
  }
  .panel__meta span + span::before {
    content: '·';
    margin-inline: 0.55em;
  }
  .panel__n {
    font-weight: 700;
    color: var(--accent);
  }
  .panel__title {
    margin-top: 0.8rem;
    font-size: clamp(1.7rem, 1.15rem + 2.6vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .panel__title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole panel is the link. */
  .panel__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .panel__title a:focus-visible {
    outline: none;
  }
  .panel:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @supports not selector(:has(a)) {
    .panel:focus-within {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }
  .panel__finding {
    margin-top: 0.9rem;
    max-width: 34rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .panel__tags {
    margin-top: 0.9rem;
    color: var(--ink-3);
  }
  .panel__text .arrow {
    margin-top: auto;
    padding-top: 1.25rem;
    background-position: 0 100%;
  }
  .panel:hover .arrow {
    color: var(--accent);
  }
  .panel:hover .arrow::after {
    translate: 0.22em 0;
  }

  .panel__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-width: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 52rem) {
    .panel__side {
      padding: 0 0 0 clamp(1.5rem, 3vw, 3rem);
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }
  .panel__glyph :global(.glyph) {
    width: min(100%, 15rem);
    color: var(--ink-2);
  }
  .panel__stats {
    display: grid;
    gap: 0.8rem;
  }
  .panel__stats div {
    display: grid;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
  }
  .panel__stats dt {
    order: 2;
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--ink-3);
  }
  .panel__stats dd {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .panel__stats div:first-child dd {
    color: var(--accent);
  }

  .panel--end {
    width: min(70vw, 24rem);
    align-content: center;
    gap: 0.75rem;
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-lg);
  }
  .panel__endline {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .panel__endline a {
    text-decoration: none;
  }
  .panel__endline a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .panel__endline .icon-arrow {
    width: 0.5em;
    height: 0.5em;
    margin-left: 0.2em;
    color: var(--accent-fill);
  }

  /* ---------- pinned: the page's scroll carries the track sideways ---------- */
  .reel.is-pinned .reel__pin {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: calc(var(--header) + 0.5rem) 1rem;
    overflow: hidden;
  }
  .reel.is-pinned .reel__head {
    flex: none;
  }
  .reel.is-pinned .reel__track {
    flex: none;
    width: max-content;
    overflow: visible;
    scroll-snap-type: none;
    will-change: transform;
    /* Vertical swipes scroll the page; sideways ones are handled by the script. */
    touch-action: pan-y;
    cursor: grab;
  }
  .reel.is-pinned.is-dragging .reel__track {
    cursor: grabbing;
  }
  .reel.is-pinned .panel {
    width: min(74vw, 62rem);
  }
  .reel.is-pinned .panel--end {
    width: min(70vw, 24rem);
  }

  /* Pinned on a wide but short screen (most laptops): tighten the panel so
     it still fits one screen instead of falling back to the row. */
  @media (min-width: 52rem) and (max-height: 54rem) {
    .reel.is-pinned .reel__title {
      max-width: none;
      margin-top: 0.5rem;
      font-size: var(--step-2);
    }
    .reel.is-pinned .reel__head {
      margin-bottom: 1rem;
    }
    .reel.is-pinned .panel {
      min-height: 0;
      padding: 1.5rem 2rem;
      gap: 1rem 2.5rem;
    }
    .reel.is-pinned .panel__title {
      font-size: clamp(1.7rem, 1rem + 2vw, 2.6rem);
    }
    .reel.is-pinned .panel__finding {
      margin-top: 0.7rem;
      font-size: 1rem;
    }
    .reel.is-pinned .panel__glyph :global(.glyph) {
      width: 9.5rem;
    }
    .reel.is-pinned .panel__side {
      gap: 0.75rem;
    }
    .reel.is-pinned .panel__stats {
      gap: 0.45rem;
    }
    .reel.is-pinned .panel__stats div {
      padding-top: 0.4rem;
    }
    .reel.is-pinned .panel__stats dd {
      font-size: clamp(1.3rem, 0.95rem + 1.1vw, 1.85rem);
    }
  }
  @media (min-width: 52rem) and (max-height: 41rem) {
    .reel.is-pinned .panel__glyph,
    .reel.is-pinned .panel__tags {
      display: none;
    }
    .reel.is-pinned .panel__text .arrow {
      padding-top: 0.75rem;
    }
  }

  /* Pinned on a narrow screen: a compact panel that fits one screen. */
  @media (max-width: 51.99rem) {
    .reel.is-pinned .reel__title {
      margin-top: 0.6rem;
      font-size: var(--step-2);
    }
    .reel.is-pinned .reel__head {
      margin-bottom: 1rem;
    }
    .reel.is-pinned .panel {
      width: min(84vw, 26rem);
      gap: 0.9rem;
      padding: 1.15rem 1.25rem;
    }
    .reel.is-pinned .panel__glyph,
    .reel.is-pinned .panel__tags,
    .reel.is-pinned .panel__stats div:not(:first-child) {
      display: none;
    }
    .reel.is-pinned .panel__title {
      margin-top: 0.5rem;
      font-size: clamp(1.5rem, 6.5vw, 2rem);
    }
    .reel.is-pinned .panel__finding {
      margin-top: 0.6rem;
      font-size: 1rem;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 5;
      line-clamp: 5;
      overflow: hidden;
    }
    .reel.is-pinned .panel__text .arrow {
      padding-top: 0.75rem;
    }
    .reel.is-pinned .panel__side {
      padding-top: 0.75rem;
    }
    .reel.is-pinned .panel__stats div {
      padding-top: 0;
      border-top: 0;
    }
  }
  @media (max-width: 51.99rem) and (max-height: 42rem) {
    .reel.is-pinned .panel__finding {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
  /* The shortest phones: a one-line heading and a tighter panel. */
  @media (max-width: 51.99rem) and (max-height: 38rem) {
    .reel.is-pinned .reel__title .accent {
      display: none;
    }
    .reel.is-pinned .reel__head {
      margin-bottom: 0.75rem;
    }
    .reel.is-pinned .panel {
      gap: 0.6rem;
      padding: 0.9rem 1.1rem;
    }
  }
</style>
