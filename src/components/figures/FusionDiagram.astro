---
/**
 * Schematic of the HVB-Persian method as described in the paper's summary:
 * a fine-tuned ParsBERT classifier and VADER lexicon scores, combined by a
 * weighted score fusion whose weights are tuned on validation data.
 */
---

<div class="fusion" role="img" aria-label="Diagram: a Persian product review goes to two models in parallel. A fine-tuned ParsBERT classifier produces class scores from context; the VADER lexicon produces a polarity score from word-level rules. A weighted fusion, with weights tuned on validation data, combines the two into the final sentiment label.">
  <div class="fusion__in" aria-hidden="true">
    <span class="fusion__tag">Input</span>
    <strong>Product review</strong>
    <span>Persian text</span>
  </div>

  <div class="fusion__split" aria-hidden="true">
    <div class="fusion__branch">
      <span class="fusion__tag">Contextual</span>
      <strong>ParsBERT, fine-tuned</strong>
      <span>class scores from the whole sentence</span>
    </div>
    <div class="fusion__branch">
      <span class="fusion__tag">Lexicon</span>
      <strong>VADER</strong>
      <span>polarity score from word-level rules</span>
    </div>
  </div>

  <div class="fusion__merge" aria-hidden="true">
    <span class="fusion__tag">Fusion</span>
    <strong>Weighted sum of scores</strong>
    <span>weights tuned on validation data</span>
  </div>

  <div class="fusion__out" aria-hidden="true">
    <span class="fusion__tag">Output</span>
    <strong>Sentiment label</strong>
  </div>
</div>

<style>
  .fusion {
    --line: var(--rule-strong);
    display: grid;
    gap: 1.75rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .fusion > div,
  .fusion__branch {
    position: relative;
  }
  .fusion__in,
  .fusion__branch,
  .fusion__merge,
  .fusion__out {
    display: grid;
    gap: 0.15rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
  }
  .fusion strong {
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .fusion span {
    color: var(--ink-2);
  }
  .fusion__tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3) !important;
  }
  .fusion__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .fusion__merge {
    border-color: var(--mark-fill);
    box-shadow: inset 3px 0 0 var(--mark-fill);
  }
  .fusion__out {
    background: var(--ink);
    border-color: var(--ink);
  }
  .fusion__out strong {
    color: var(--paper);
  }
  .fusion__out .fusion__tag {
    color: color-mix(in srgb, var(--paper) 70%, transparent) !important;
  }

  /* Connectors: a short vertical line above each stage after the first. */
  .fusion__split::before,
  .fusion__merge::before,
  .fusion__out::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -1.75rem;
    height: 1.75rem;
    border-left: 1px solid var(--line);
  }
  .fusion__split::before {
    left: 25%;
    width: 50%;
    height: 0.875rem;
    top: -0.875rem;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .fusion__in::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.875rem;
    height: 0.875rem;
    border-left: 1px solid var(--line);
  }
  .fusion__merge::before {
    left: 25%;
    width: 50%;
    height: 0.875rem;
    top: -1.75rem;
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .fusion__merge::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.875rem;
    height: 0.875rem;
    border-left: 1px solid var(--line);
  }

  @media (min-width: 52rem) {
    .fusion {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: center;
      gap: 2rem;
    }
    .fusion__split {
      grid-template-columns: 1fr;
    }
    .fusion__in::after,
    .fusion__merge::after {
      display: none;
    }
    .fusion__split::before,
    .fusion__merge::before,
    .fusion__out::before {
      left: -2rem;
      top: 50%;
      width: 2rem;
      height: 0;
      border: 0;
      border-top: 1px solid var(--line);
    }
    .fusion__split::before,
    .fusion__merge::before {
      top: 12%;
      height: 76%;
      width: 1rem;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .fusion__split::before {
      left: -1rem;
      border-left: 1px solid var(--line);
    }
    .fusion__merge::before {
      left: -2rem;
      border-right: 1px solid var(--line);
    }
    .fusion__split::after,
    .fusion__merge::after {
      content: '';
      display: block;
      position: absolute;
      top: 50%;
      width: 1rem;
      height: 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
    .fusion__split::after {
      left: -2rem;
    }
    .fusion__merge::after {
      left: -1rem;
    }
  }
</style>
