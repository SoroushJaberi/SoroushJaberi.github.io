---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import WorkReel from '@/components/WorkReel.astro';
import PointField from '@/components/PointField.astro';
import PubList from '@/components/PubList.astro';
import Timeline from '@/components/Timeline.astro';
import Frames from '@/components/Frames.astro';
import Paths from '@/components/Paths.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { education, interests, skills, principles } from '@/data/profile';
import { getFeatured, getPublications, getWork } from '@/lib/content';

const featured = await getFeatured();
const total = (await getWork()).length;
const publications = await getPublications();
const msc = education[0]!;

const numbers = [
  { value: msc.gpa, label: 'M.Sc. GPA (4.0 / 4.0)' },
  { value: 'Jan 2027', label: 'expected thesis defense' },
  { value: '3', label: 'university courses as teaching assistant' },
  { value: '32,000', label: 'model answers scored in my latest study' },
];
---

<Base>
  <Hero />

  <!-- About: the overview continues before any single project -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap about">
      <div class="about__text">
        <header class="head" data-reveal>
          <p class="label label--tick">About</p>
          <h2 id="about-title">Research-first, <span class="accent">build-minded.</span></h2>
        </header>
        <div class="about__body" data-reveal style="--i: 1">
          <p class="lede">
            I am an M.Sc. candidate in Artificial Intelligence and a data scientist, focused on turning careful
            research into machine learning systems that work in practice.
          </p>
          <p>
            My work spans Persian sentiment analysis, medical image segmentation, retrieval-augmented generation and
            the evaluation of large language models. I care about experiments that are clean enough to reproduce and
            systems that are understandable enough to trust.
          </p>
          <p>
            I have been a teaching assistant for three university courses, and I now teach in the open through The AI
            Path, a free course that goes from Python to AI agents.
          </p>
          <p class="about__links">
            <a class="btn btn--quiet" href="/about/">More about me</a>
            <a class="arrow" href={site.cv}>Download CV</a>
          </p>
        </div>
      </div>

      <aside class="about__side" data-reveal style="--i: 2">
        <div class="card principles">
          <p class="label">How I work</p>
          <ol role="list">
            {
              principles.map((p, i) => (
                <li>
                  <span class="num" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <span>{p}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>

      <dl class="numbers" data-reveal style="--i: 2">
        {
          numbers.map((n) => (
            <div>
              <dt>{n.label}</dt>
              <dd class="num">{n.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- What I work on, and with what -->
  <section class="section section--tint" id="focus" aria-labelledby="focus-title">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="label label--tick">Focus</p>
        <h2 id="focus-title">What I work on, <span class="accent">and with what.</span></h2>
      </header>

      <ul class="interests" role="list">
        {
          interests.map((item, i) => (
            <li class="card has-icon" data-reveal style={`--i: ${i}`}>
              <span class="interests__icon">
                <Icon name={item.icon} size={24} />
              </span>
              <h3>{item.area}</h3>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="toolkit" data-reveal>
        <h3 class="label">Toolkit</h3>
        <dl>
          {
            skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>{s.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <WorkReel entries={featured} total={total} />

  <PointField />

  <section class="section" id="research" aria-labelledby="research-title">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="label label--tick">Research</p>
        <h2 id="research-title">Papers, manuscripts <span class="accent">and independent studies.</span></h2>
        <p class="lede">Each is listed with its status. A preprint is called a preprint.</p>
      </header>
      <PubList items={publications} detailed={false} />
      <p class="more" data-reveal>
        <a class="arrow" href="/research/">Research in full</a>
      </p>
    </div>
  </section>

  <section class="section section--tint" id="trajectory" aria-labelledby="trajectory-title">
    <div class="wrap">
      <header class="head head--center" data-reveal>
        <p class="label label--tick">Trajectory</p>
        <h2 id="trajectory-title">Seven years, <span class="accent">one direction.</span></h2>
        <p class="lede">From a first algorithms course to measuring what language models do with evidence.</p>
      </header>
      <Timeline />
    </div>
  </section>

  <section class="section person" id="photos" aria-labelledby="photos-title">
    <div class="wrap">
      <header class="head head--center" data-reveal>
        <p class="label label--tick">In frame</p>
        <h2 id="photos-title">The person <span class="accent">behind the work.</span></h2>
      </header>
      <Frames />
      <p class="person__links" data-reveal>
        <a class="btn btn--quiet" href="/about/">More about me</a>
        <a class="arrow" href="/contact/">Get in touch</a>
      </p>
    </div>
  </section>

  <section class="section section--tint" id="together" aria-labelledby="paths-title">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="label label--tick">Working together</p>
        <h2 id="paths-title">Start from whichever <span class="accent">describes you.</span></h2>
      </header>
      <Paths />
    </div>
  </section>
</Base>

<script>
  import '@/scripts/scrollfx';
</script>

<style>
  /* ---- about ---- */
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (min-width: 62rem) {
    .about {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
    .numbers {
      grid-column: 1 / -1;
    }
  }
  .about .head {
    margin-bottom: 1.5rem;
  }
  .about__body > * + * {
    margin-top: 1rem;
  }
  .about__body p:not(.lede) {
    max-width: 38rem;
    color: var(--ink-2);
  }
  .about__body .lede {
    color: var(--ink);
    max-width: 38rem;
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-top: 0.6rem;
  }
  .principles {
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .principles ol {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.1rem;
  }
  .principles li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .principles .num {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }
  .numbers div {
    display: grid;
    align-content: start;
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .numbers div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .numbers div {
      padding-inline: 1.25rem;
      border-left: 1px solid var(--rule);
    }
    .numbers div:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  .numbers dt {
    order: 2;
    margin-top: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-3);
  }
  .numbers dd {
    font-family: var(--display);
    font-size: clamp(1.6rem, 1.2rem + 1.9vw, 2.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .numbers div:first-child dd {
    color: var(--accent);
  }

  /* ---- focus ---- */
  .interests {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
  }
  .interests li {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    transition:
      border-color 0.3s,
      translate 0.3s var(--ease);
  }
  .interests li:hover {
    border-color: var(--accent);
    translate: 0 -3px;
  }
  .interests__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .interests h3 {
    margin-top: 1rem;
    font-size: 1.1875rem;
  }
  .interests p {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .toolkit {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .toolkit dl {
    margin-top: 0.9rem;
    border-top: 1px solid var(--rule-strong);
  }
  .toolkit dl div {
    display: grid;
    gap: 0.2rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .toolkit dl div {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
  .toolkit dt {
    font-weight: 700;
    color: var(--ink);
  }
  .toolkit dd {
    color: var(--ink-2);
    line-height: 1.55;
  }

  .more {
    margin-top: 1.75rem;
  }

  /* ---- photos ---- */
  .person {
    overflow-x: clip;
  }
  .person .head {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .person__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
