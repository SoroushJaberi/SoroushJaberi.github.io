---
import Base from '@/layouts/Base.astro';
import Stage from '@/components/Stage.astro';
import WorkReel from '@/components/WorkReel.astro';
import PubList from '@/components/PubList.astro';
import Timeline from '@/components/Timeline.astro';
import Frames from '@/components/Frames.astro';
import Paths from '@/components/Paths.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { education, interests } from '@/data/profile';
import { getFeatured, getPublications, getWork } from '@/lib/content';

const featured = await getFeatured();
const total = (await getWork()).length;
const publications = await getPublications();
const msc = education[0]!;
---

<Base>
  <Stage />

  <WorkReel entries={featured} total={total} />

  <section class="section" id="research" aria-labelledby="research-title">
    <div class="wrap rail">
      <header class="rail__label">
        <p class="label label--tick">Research</p>
        <p class="small">Papers, manuscripts and independent studies, each with its status.</p>
      </header>
      <div>
        <h2 id="research-title" class="statement" data-reveal>
          Can a model be trusted with the evidence it is handed, and can it be made to work in a language with
          <span class="accent">far less data behind it?</span>
        </h2>
        <PubList items={publications} detailed={false} />
        <ul class="interests" role="list">
          {
            interests.map((item, i) => (
              <li class="has-icon" data-reveal style={`--i: ${i}`}>
                <Icon name={item.icon} size={26} />
                <h3>{item.area}</h3>
                <p class="small">{item.detail}</p>
              </li>
            ))
          }
        </ul>
        <p class="more" data-reveal>
          <a class="arrow" href="/research/">Research in full</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="trajectory" aria-labelledby="trajectory-title">
    <div class="wrap">
      <header class="center-head" data-reveal>
        <p class="label label--tick">Trajectory</p>
        <h2 id="trajectory-title" class="display">Seven years, <span class="accent">one direction.</span></h2>
        <p class="lede">
          From a first algorithms course to measuring what language models do with evidence.
        </p>
      </header>
      <Timeline />
    </div>
  </section>

  <section class="section person" id="person" aria-labelledby="person-title">
    <div class="wrap">
      <header class="center-head" data-reveal>
        <p class="label label--tick">The person</p>
        <h2 id="person-title" class="display">Behind <span class="accent">the numbers.</span></h2>
      </header>
      <Frames />
      <div class="person__text" data-reveal>
        <p class="lede">
          I am based in {site.location}, finishing an M.Sc. in Artificial Intelligence with a GPA of {msc.gpa}. I have
          been a teaching assistant for three university courses, and I now teach in the open through The AI Path.
        </p>
        <p class="person__links">
          <a class="btn btn--quiet" href="/about/">More about me</a>
          <a class="arrow" href={site.cv}>CV</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="together" aria-labelledby="paths-title">
    <div class="wrap rail">
      <header class="rail__label">
        <p class="label label--tick">Working together</p>
        <p class="small">Start from whichever describes you.</p>
      </header>
      <div>
        <h2 id="paths-title" class="sr-only">Working together</h2>
        <Paths />
      </div>
    </div>
  </section>
</Base>

<script>
  import '@/scripts/scrollfx';
</script>

<style>
  .statement {
    max-width: 22ch;
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .interests {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: 1px;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .interests li {
    padding: 1.5rem;
    background: var(--paper);
    transition: background-color 0.3s;
  }
  .interests li:hover {
    background: var(--paper-2);
  }
  .interests :global(.icon) {
    color: var(--mark);
  }
  .interests h3 {
    margin-top: 1rem;
    font-size: 1.125rem;
  }
  .interests .small {
    margin-top: 0.4rem;
  }
  .more {
    margin-top: 1.75rem;
  }

  .center-head {
    display: grid;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .center-head .display {
    margin-top: 1.1rem;
    max-width: 14ch;
  }
  .center-head .lede {
    margin-top: 1.25rem;
    max-width: 32rem;
  }

  .person {
    overflow-x: clip;
  }
  .person__text {
    display: grid;
    justify-items: center;
    text-align: center;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .person__text .lede {
    max-width: 40rem;
  }
  .person__links {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
  }
</style>
